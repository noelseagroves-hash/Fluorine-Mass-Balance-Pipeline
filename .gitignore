# Raw instrument data — unpublished lab measurements.
# This repository is public. Never commit real exports.
*_RawData/
*Quantitation_ByCompound*.csv

# Batch runs. TA_Processing.ipynb in the repository root is the template and
# stays blank; a run is a copy of it inside runs/, filled in with that batch's
# phase, amounts and results. Those copies and their outputs stay local.
runs/

# Synthetic fixtures are safe to commit and must survive the rule above.
!tests/fixtures/**/*.csv

# Scientist inputs: machine-specific folder paths and per-run answers.
answers.yaml

# Editor settings holding an interpreter path specific to this machine.
.vscode/

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
